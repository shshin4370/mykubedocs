# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)

# ── 답변 생성 모델 ───────────────────────────────
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano          # 2일차.ipynb 와 동일 (gpt-4o-mini 등으로 변경 가능)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── 임베딩 모델 (인덱스를 만들 때와 앱을 실행할 때 같아야 합니다) ──
EMBEDDING_PROVIDER=openai      # openai | huggingface (API 키 없이 로컬 실행)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=BAAI/bge-m3

# ── 크롤링 범위 (선택) ───────────────────────────
MAX_PAGES_PER_HOST=200         # 사이트(호스트)당 최대 수집 페이지
MAX_DEPTH=3                    # 시작 URL로부터 따라갈 링크 깊이
CRAWL_DELAY_SEC=0.5            # 요청 사이 대기 시간(초)
# EXTRA_SEEDS=https://docs.redhat.com/en/documentation/openshift_container_platform/latest

# ── 검색 (선택) ──────────────────────────────────
RETRIEVE_K=5
MAX_HISTORY_TURNS=6
